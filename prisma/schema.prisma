// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
model User {
  id            String    @id @default(uuid())
  email         String    @unique
  password      String?  
  name          String?
  image         String?
  emailVerified DateTime? @map("email_verified")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // Relations
  accounts         Account[]
  sessions         Session[]
  createdTrips     Trip[]     @relation("CreatedTrips")
  places           Place[]
  photos           Photo[]
  reviews          Review[]
  
  // Relations: Membership
  tripMemberships  TripMember[]

  // Relations: Friends
  friendsAsUserA   Friendship[] @relation("UserA")
  friendsAsUserB   Friendship[] @relation("UserB")

  // Relations: Notifications
  notificationsReceived Notification[] @relation("NotificationRecipient")
  notificationsSent     Notification[] @relation("NotificationSender")
}
model Friendship {
  id        String   @id @default(uuid())
  userAId   String
  userBId   String
  status    String   @default("PENDING")

  userA     User     @relation("UserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB     User     @relation("UserB", fields: [userBId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userAId, userBId])
  @@index([userAId])
  @@index([userBId])
}
// NextAuth.js用のモデル
model Account {
  id                String  @id @default(uuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}
model Notification {
  id          String   @id @default(uuid())
  
  // 誰宛の通知か
  userId      String
  user        User     @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)

  // 誰がアクションしたか (フレンド申請者など)
  actorId     String
  actor       User     @relation("NotificationSender", fields: [actorId], references: [id], onDelete: Cascade)

  // 通地の種類
  type        String   // 'FRIEND_REQUEST', 'TRIP_INVITE', 'NEW_COMMENT', 'TRIP_JOINED'
  
  // 既読状態
  isRead      Boolean  @default(false)

  // 関連リソース (オプショナル: 通知の種類による)
  tripId      String?
  trip        Trip?    @relation(fields: [tripId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  
  @@index([userId]) // 通知一覧を素早く取得するため
}

// 旅行モデル
model Trip {
  id             String    @id @default(uuid())
  title          String
  description    String?
  startDate      DateTime
  endDate        DateTime?
  isShared       Boolean   @default(true)
  status         TripStatus @default(DRAFT)
  mapCenterLat   Float?
  mapCenterLng   Float?
  
  createdBy      String
  creator        User      @relation("CreatedTrips", fields: [createdBy], references: [id], onDelete: Cascade)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  
  places         Place[]
  members        TripMember[]
  photos         Photo[]
  reviews        Review[]
  notifications  Notification[] // Tripに関連する通知
}
model Place {
  id             String    @id @default(uuid())
  tripId         String
  trip           Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  
  googlePlaceId  String
  name           String
  address        String?
  latitude       Float
  longitude      Float
  
  visitedAt      DateTime?
  order          Int       @default(0)

  reviewText     String?
  rating         Int?
  
  createdBy      String
  creator        User      @relation(fields: [createdBy], references: [id])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  
  photos         Photo[]
  reviews        Review[]
}

model TripMember {
  tripId         String
  userId         String
  
  role           String    @default("member")
  joinedAt       DateTime  @default(now())
  
  trip           Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@id([tripId, userId])
}
// スケジュールモデル
model Photo {
  id             String    @id @default(uuid())
  url            String
  description    String?
  
  tripId         String?
  placeId        String?
  
  trip           Trip?     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  place          Place?    @relation(fields: [placeId], references: [id], onDelete: Cascade)
  
  uploadedBy     String
  uploader       User      @relation(fields: [uploadedBy], references: [id])
  
  createdAt      DateTime  @default(now())
}

model Review {
  id             String    @id @default(uuid())
  text           String
  rating         Int?
  
  tripId         String?
  placeId        String?
  
  trip           Trip?     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  place          Place?    @relation(fields: [placeId], references: [id], onDelete: Cascade)

  createdBy      String
  creator        User      @relation(fields: [createdBy], references: [id])
  
  createdAt      DateTime  @default(now())
}

enum TripStatus {
  DRAFT
  PLANNING
  ONGOING
  COMPLETED
  CANCELLED
}